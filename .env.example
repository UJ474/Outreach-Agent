# =====================================================================
# Outreach Agent Environment Configuration Template
# Copy this file to .env and fill in your credentials
# =====================================================================

# --- Groq LLM API ---
# Get an API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gmail SMTP Sending ---
# Use your personal or work Gmail address
GMAIL_ADDRESS=your_email@gmail.com

# 16-character App Password generated via:
# Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Rate Limiting & Safety Defaults ---
DAILY_SEND_CAP=30
MIN_DELAY_SEC=30
MAX_DELAY_SEC=90
